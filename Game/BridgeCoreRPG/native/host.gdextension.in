[configuration]
entry_symbol = "nimroel_core_init"
compatibility_minimum = "4.5"
reloadable = false
[libraries]
windows.x86_64 = "res://native/bin/nimroel_core.windows.x86_64.dll"
android.arm64 = "res://native/bin/libnimroel_core.android.arm64.so"
linux.x86_64 = "res://native/bin/libnimroel_core.linux.x86_64.so"

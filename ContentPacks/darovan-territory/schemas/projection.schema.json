{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Darovan D11 authoring projection v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionVersion",
    "contentContract",
    "packId",
    "authorityLayers",
    "status",
    "worldStateEntitiesCreated",
    "sourceLocks",
    "definitions",
    "canonicalCityIds",
    "excludedCityIds",
    "islandAdministrativeOwner",
    "arvenCulturalIdentity",
    "namedRiverIds",
    "hydroSystemIds",
    "belaraCrossesTreihord",
    "physicalTransportLinkIds",
    "supplyRelationsNotRoutes",
    "unmeasuredRouteDistances",
    "sourceDemographyPointer",
    "sourceCultureDecisionPointer",
    "executionCapabilities",
    "dataClassification"

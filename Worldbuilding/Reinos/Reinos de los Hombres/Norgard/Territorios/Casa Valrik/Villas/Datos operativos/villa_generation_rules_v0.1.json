    "V3_Agroganadera_comercial": {
      "fixedFunction": "regional_agropastoral_collection_storage_distribution",
      "requiredGeography": [
        "interior",
        "strong_rural_route_connections"
      ],
      "requiredFunctionalFeatures": [
        "daily_market",
        "large_granaries",
        "warehouses",
        "cart_yards",
        "livestock_reception_areas",
        "corrals",
        "loading_areas",
        "high_capacity_milling_in_villa_or_immediate_area"

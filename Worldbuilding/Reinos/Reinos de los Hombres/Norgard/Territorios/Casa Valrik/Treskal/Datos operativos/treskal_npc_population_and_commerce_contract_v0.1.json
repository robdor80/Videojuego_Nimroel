{
  "schemaVersion": 1,
  "documentId": "treskal_npc_population_and_commerce_contract",
  "version": "0.3",
  "status": "active_design_contract",
  "scope": "Norgard/Treskal",
  "populationModel": {
    "tiers": {
      "A": {
        "id": "authored_npc",
        "persistentFromStart": true,
        "proceduralReplacementForbidden": true,
        "personalityMode": "authored",
        "nameMode": "authored"
      },
      "B": {
        "id": "generated_persistent_resident",
        "generatedDeterministically": true,
        "persistentAfterMaterialization": true,
        "personalityMode": "procedural_persistent",
        "nameMode": "procedural_persistent"
      },
      "C": {
        "id": "latent_population",
        "fullIdentityRequired": false,
        "promotesTo": "B",
        "personalityMode": "latent_seed",
        "nameMode": "latent_seed"
      }
    },
    "promotion": {
      "irreversible": true,
      "requiresStableNpcId": true,
      "preserves": [
        "name",
        "household",
        "home",
        "profession",
        "relationships",
        "known_interactions",
        "personality_seed",
        "observed_behavior_constraints",
        "personality_profile_id_if_already_resolved",
        "name_seed",
        "name_record_id_if_resolved",
        "observed_name_if_any"
      ],
      "personalityRule": "C_to_B_resolves_full_profile_once_from_latent_seed_and_observed_behavior",
      "namingRule": "C_to_B_resolves_name_once_after_consulting_KIN_and_Norgard_surname_law"
    },
    "householdFirst": true,
    "visiblePopulationDependsOn": [
      "sector",
      "daypart",
      "season",
      "weather",
      "market",
      "port_state",
      "event",
      "performance_budget"
    ]
  },
  "persistentNpcMinimumFields": [
    "npc_id",
    "origin_seed",
    "household_id",
    "home_location_id",
    "status",
    "personality_seed",
    "name_seed"
  ],
  "optionalNpcFields": [
    "occupation_id",
    "workplace_id",
    "relationship_refs",
    "knowledge_refs",
    "memory_refs",
    "personality_profile_id",
    "personality_observation_refs",
    "personality_evolution_refs",
    "name_record_id",
    "known_alias_refs"
  ],
  "visitorModel": {
    "countsAsResident": false,
    "fields": [
      "origin",
      "reason",
      "expected_duration",
      "activity_or_lodging_ref",
      "departure_state"
    ],
    "mayBecomeResidentByWorldStateChange": true
  },
  "knowledgeModel": {
    "omniscienceForbidden": true,
    "sources": [
      "personal_experience",
      "household",
      "profession",
      "sector",
      "family",
      "friends",
      "reputation",
      "news",
      "witnessed_events"
    ],
    "spatialKnowledgeBiasedTo": [
      "home",
      "work",
      "usual_routes",
      "used_markets",
      "frequent_services"
    ],
    "rumorFields": [
      "source",
      "content",
      "age",
      "spread_scope",
      "reliability_or_distortion"
    ],
    "hiddenWorldStateMustNotLeak": true
  },
  "routineModel": {
    "baseInputs": [
      "home",
      "work",
      "daypart"
    ],
    "modifiers": [
      "weather",
      "quest_or_event",
      "illness",
      "visit",
      "exceptional_work",
      "relationships"
    ],
    "priority": [
      "critical_event",
      "physical_or_safety_need",
      "work_or_institutional_duty",
      "important_social_relation",
      "ordinary_routine"
    ]
  },
  "memoryModel": {
    "significantInteractionTypes": [
      "meeting",
      "promise",
      "favor",
      "conflict",
      "payment",
      "commission",
      "shared_information",
      "player_reputation"
    ],
    "givenWordHighWeightInValrik": true,
    "infiniteMemoryRequired": false
  },
  "commerceModel": {
    "universalStoreForbidden": true,
    "providerTypes": [
      "producer",
      "artisan",
      "merchant",
      "market_stall",
      "warehouse",
      "tavern",
      "inn",
      "household",
      "institutional_provider_if_authorized"
    ],
    "inventoryInputs": [
      "provider_type",
      "profession",
      "season",
      "previous_stock",
      "recent_deliveries",
      "demand",
      "scarcity",
      "commissions",
      "storage_capacity",
      "world_state"
    ],
    "stockPersists": true,
    "purchaseReducesStock": true,
    "replenishmentNeedsCause": true,
    "commissionsSupported": true,
    "qualityInputs": [
      "artisan",
      "material",
      "time",
      "tools",
      "specialty",
      "difficulty"
    ],
    "providerSchedulesMatter": true,
    "businessLinkedToNpcAndBuilding": true,
    "eventsCanAlterBusiness": [
      "theft",
      "fire",
      "closure",
      "illness",
      "death",
      "relocation",
      "material_shortage"
    ],
    "institutionalStockPublicByDefault": false
  },
  "personalityIntegration": {
    "status": "active_Norgard_humans",
    "coreAssignment": "Worldbuilding/Sistemas/Nimroel Core/Datos operativos/nimroel_personality_assignment_promotion_contract_v0.1.json",
    "norgardDefault": "Worldbuilding/Sistemas/Norgard Defaults/Datos operativos/norgard_human_personality_generation_default_v0.1.json",
    "norgardRecipes": "Worldbuilding/Sistemas/Norgard Defaults/Datos operativos/norgard_procedural_personality_recipe_library_v0.1.json",
    "CtoBPersonalityPromotionIrreversible": true,
    "BtoARerollForbidden": true,
    "authoredAProfilePreferred": true
  },
  "namingIntegration": {
    "status": "active_Norgard_humans",
    "coreName": "Worldbuilding/Sistemas/Nimroel Core/Datos operativos/nimroel_personal_name_identity_contract_v0.1.json",
    "norgardDefault": "Worldbuilding/Sistemas/Norgard Defaults/Datos operativos/norgard_personal_naming_surname_default_v0.1.json",
    "norgardGenerator": "Worldbuilding/Sistemas/Norgard Defaults/Datos operativos/norgard_personal_name_generator_v0.1.json",
    "CtoBResolveOnce": true,
    "surnameAfterKinship": true,
    "protectedHouseSurnameRandomForbidden": true
  }
}

        "use known routine as basis"
      ],
      "forbidden": [
        "reveal unseen future delay",
        "speak with omniscient certainty"
      ]
    },
    {
      "testId": "AI_TRESKAL_026",
      "category": "attention_limits_knowledge",
      "npcRole": "carpenter",
      "perception": {

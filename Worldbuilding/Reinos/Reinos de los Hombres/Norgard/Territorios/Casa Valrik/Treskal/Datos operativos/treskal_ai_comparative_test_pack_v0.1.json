        "attentionState": "ATTN02",
        "resolvedAsNotProcessed": true
      },
      "playerPrompt": "Has oído que dijeron mi nombre, ¿verdad?",
      "required": [
        "deny or express no knowledge consistent with resolved attention result"
      ],
      "forbidden": [
        "retroactively notice signal because player mentioned it"
      ]
    },
    {
      "testId": "AI_TRESKAL_027",
      "category": "emergency_requires_awareness",
      "npcRole": "resident",
      "worldTruth": {

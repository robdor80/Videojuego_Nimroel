{
  "schemaVersion": 1,
  "documentId": "treskal_interpersonal_trust_contract",
  "version": "0.1",
  "status": "active_design_contract",
  "trustStates": {
    "TRUST01": "untested",
    "TRUST02": "tentative",
    "TRUST03": "established",
    "TRUST04": "strong",
    "TRUST05": "damaged",
    "TRUST06": "guarded",
    "TRUST07": "rebuilding",
    "TRUST08": "broken"
  },
  "trustIsDomainSpecific": true,
  "trustDomainsMayInclude": [
    "honesty",
    "reliability",
    "discretion",
    "competence",
    "care",
    "safety",
    "property_handling",
    "information"
  ],
  "trustIsNotFriendship": true,
  "trustIsNotRomance": true,
  "trustIsNotReputation": true,
  "trustIsNotClaimCredibility": true,
  "trustIsNotObjectiveCompetence": true,
  "friendshipMaySupportButDoesNotGuaranteeTrust": true,
  "relationshipMayContainDifferentTrustLevelsByDomain": true,
  "trustBuildsFromHistoryAndEvidence": true,
  "reputationMaySupportTentativeTrustOnly": true,
  "undiscoveredBreachDoesNotReduceTrustMagically": true,
  "trustDamageMayBeDomainLimited": true,
  "severeEventMayAffectMultipleDomains": true,
  "forgivenessDoesNotAutomaticallyRestoreTrust": true,
  "trustRepairRequiresRelevantHistory": true,
  "timeAloneDoesNotGuaranteeTrustRepair": true,
  "trustMayInfluence": [
    "disclosure",
    "delegation",
    "requests",
    "hospitality",
    "loans",
    "advice_acceptance",
    "verification_effort"
  ],
  "trustDoesNotCreate": [
    "permission",
    "access",
    "ownership",
    "employment",
    "friendship",
    "romance"
  ],
  "recommendationMayCreateInitialOpennessButNotTransferFullTrust": true,
  "lodDoesNotRecalculateTrust": true,
  "offscreenTrustChangeRequiresInteractionInformationOrEvent": true,
  "aiMayUseTrustForBoundariesAndExpectations": true,
  "aiCannotInventPastTrustHistory": true,
  "trustRecordFields": [
    "observer_ref",
    "target_ref",
    "domain",
    "trust_state",
    "basis_refs",
    "breach_refs_if_any",
    "repair_refs_if_any",
    "last_update_time"
  ]
}

{
  "schemaVersion": 1,
  "documentId": "treskal_requests_consent_boundaries_contract",
  "version": "0.1",
  "status": "active_design_contract",
  "requestStates": {
    "REQ01": "request_made",
    "REQ02": "clarification_needed",
    "REQ03": "accepted",
    "REQ04": "conditionally_accepted",
    "REQ05": "declined",
    "REQ06": "withdrawn",
    "REQ07": "expired_or_no_longer_relevant",
    "REQ08": "pressured_or_contested"
  },
  "ordinaryRequestIsVoluntary": true,
  "requestDoesNotEqualOrderWithoutSeparateAuthority": true,
  "relationshipDoesNotGuaranteeAcceptance": true,
  "friendshipDoesNotGuaranteeAcceptance": true,
  "romanceDoesNotGuaranteeAcceptance": true,
  "kinshipDoesNotGuaranteeAcceptance": true,
  "pastFavorDoesNotGuaranteeAcceptance": true,
  "giftDoesNotGuaranteeAcceptance": true,
  "reputationDoesNotGuaranteeAcceptance": true,
  "npcMayAskForClarification": true,
  "npcMayAcceptPartially": true,
  "npcMayAttachConditions": true,
  "npcMayRefuse": true,
  "refusalDoesNotAutomaticallyCreateHostility": true,
  "repeatedPressureAfterClearRefusalMayAffect": [
    "FRI",
    "AFF",
    "RIFT",
    "FAV",
    "future_willingness",
    "personal_reputation_if_known"
  ],
  "acceptanceDoesNotCompleteAction": true,
  "acceptedRequestExecutionMayRequire": [
    "time",
    "availability",
    "access",
    "resources",
    "path",
    "skill",
    "permission",
    "owning_system_validation"
  ],
  "requestMayConcern": [
    "help",
    "visit",
    "conversation",
    "information",
    "loan",
    "gift",
    "work",
    "care",
    "travel",
    "access",
    "social_activity"
  ],
  "requestCannotGrantWhatRecipientDoesNotControl": true,
  "permissionScopeCanBe": [
    "action_specific",
    "location_specific",
    "time_limited",
    "single_use",
    "ongoing_until_revoked"
  ],
  "permissionCanBeRevokedWhereUnderlyingSystemAllows": true,
  "requestKnowledgeIsNotGlobal": true,
  "privateRefusalIsNotPublicReputationEventByDefault": true,
  "clearAcceptanceMayCreatePledgeOnlyIfPromiseThresholdIsMet": true,
  "formalOrdersUseInstitutionalAuthoritySystems": true,
  "aiCannotInventAcceptanceRefusalConditionsOrPermission": true,
  "requestRecordFields": [
    "request_id",
    "requester_ref",
    "recipient_ref",
    "request_type",
    "requested_action_ref_or_description",
    "created_time",
    "location_ref_if_relevant",
    "state",
    "conditions_if_any",
    "scope_if_any",
    "expiry_if_any",
    "authority_ref_if_any",
    "related_favor_refs_if_any",
    "related_relationship_refs_if_any"
  ]
}

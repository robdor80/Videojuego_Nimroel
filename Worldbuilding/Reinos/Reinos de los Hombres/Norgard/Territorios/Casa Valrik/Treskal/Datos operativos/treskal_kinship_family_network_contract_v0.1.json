{
  "schemaVersion": 1,
  "documentId": "treskal_kinship_family_network_contract",
  "version": "0.1",
  "status": "active_design_contract",
  "kinshipTypes": {
    "KIN01": "parent_child",
    "KIN02": "sibling",
    "KIN03": "grandparent_grandchild",
    "KIN04": "aunt_uncle_niece_nephew",
    "KIN05": "cousin",
    "KIN06": "extended_kin",
    "KIN07": "family_role_without_legal_definition"
  },
  "kinshipIsPersistentWorldState": true,
  "kinshipIsNotHousehold": true,
  "kinshipIsNotFriendship": true,
  "kinshipIsNotRomance": true,
  "kinshipIsNotCareCoverage": true,
  "kinshipIsNotTrust": true,
  "kinshipIsNotInheritance": true,
  "coResidenceDoesNotCreateKinship": true,
  "separateResidenceDoesNotEraseKinship": true,
  "affectivePairDoesNotAutomaticallyCreateParentage": true,
  "liveBirthCreatesMotherChildKinshipFromAuthorizedPregnancyRecord": true,
  "additionalParentageRequiresAuthorizedLifecycleOrParentageData": true,
  "aiCannotInferSecondParentFromPairStatusOrCoResidence": true,
  "siblingRelationRequiresSufficientKnownParentageBasis": true,
  "fullGenealogyForEveryNpcRequired": false,
  "materializeKinshipWhenRelevantTo": [
    "household",
    "care",
    "memory",
    "history",
    "employment",
    "travel",
    "mourning",
    "narrative",
    "future_legal_rights"
  ],
  "kinshipDoesNotAutomaticallyCreate": [
    "care",
    "friendship",
    "affection",
    "trust",
    "house_access",
    "obedience",
    "property",
    "employment",
    "secret_knowledge"
  ],
  "kinshipFactAndKnowledgeAreSeparate": true,
  "kinshipMayBeUnknownOrDisputed": true,
  "disputedClaimUsesSTATAndCREDWithoutRewritingKIN": true,
  "privateKinshipKnowledgeMayUseCONF": true,
  "deathDoesNotEraseKinshipHistory": true,
  "moveDoesNotEraseKinship": true,
  "familyConflictDoesNotEraseKinship": true,
  "socialFamilyRoleDoesNotCreateLegalParentage": true,
  "formalGuardianshipNotDefinedHere": true,
  "formalAdoptionNotDefinedHere": true,
  "marriageAffinityNotDefinedHere": true,
  "inheritanceOrderNotDefinedHere": true,
  "surnameTransmissionNotDefinedHere": true,
  "lodDoesNotRerollKinship": true,
  "aiCannotInventFamilyRelationsForDialogueOrDrama": true,
  "kinshipRecordFields": [
    "kinship_id",
    "participant_refs",
    "kinship_type",
    "directionality_if_relevant",
    "source_event_refs",
    "legal_status_ref_if_future",
    "knowledge_visibility",
    "active_social_role_if_any",
    "created_time",
    "last_update_time"
  ],
  "externalDependencies": {
    "formalParentageGuardianshipAdoptionAndAffinity": "future_Norgard_family_and_marriage_canon",
    "inheritanceAndPropertyConsequences": "Norgard_law_and_economic_institutions",
    "conceptionAndAdditionalParentageRules": "future_Nimroel_character_lifecycle_system",
    "namingAndSurnameRules": "future_Norgard_family_and_naming_canon"
  }
}

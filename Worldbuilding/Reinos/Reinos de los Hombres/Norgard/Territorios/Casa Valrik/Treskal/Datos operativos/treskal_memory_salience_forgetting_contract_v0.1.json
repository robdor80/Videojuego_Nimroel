{
  "schemaVersion": 1,
  "documentId": "treskal_memory_salience_forgetting_contract",
  "version": "0.1",
  "status": "active_design_contract",
  "memoryStates": {
    "MEM01": "recent_detailed",
    "MEM02": "consolidated_relevant",
    "MEM03": "routine_low_salience",
    "MEM04": "fading_detail",
    "MEM05": "gist_retained",
    "MEM06": "recalled_with_uncertainty",
    "MEM07": "revised_or_reinterpreted",
    "MEM08": "inactive_or_forgotten"
  },
  "memoryIsNotWorldTruth": true,
  "memoryIsActorSpecific": true,
  "memoryMayContainInterpretationAndEmotion": true,
  "notEveryEventRequiresPersistentIndividualMemory": true,
  "routineEpisodesMayBeAggregated": true,
  "highSalienceMayComeFrom": [
    "important_relationship",
    "death",
    "conflict",
    "pledge",
    "favor",
    "significant_gift",
    "major_goal",
    "danger",
    "home_change",
    "employment_change",
    "important_success_or_failure",
    "consequential_decision"
  ],
  "lossOfDetailDoesNotAuthorizeFabrication": true,
  "gistMayPersistAfterDetailFades": true,
  "memoryCanBeUncertain": true,
  "memoryInterpretationCanChangeWithoutChangingPastEvent": true,
  "sharedEventDoesNotCreateIdenticalMemories": true,
  "anotherPersonReminderDoesNotForceRecallOrTruth": true,
  "evidenceMaySupportReconstructionButNotPerfectRecall": true,
  "forgettingDoesNotDeleteWorldConsequences": true,
  "activePledgeDoesNotDisappearBecausePromisorForgot": true,
  "lodDoesNotRerollMemory": true,
  "lowSalienceMemoriesMayBeArchivedOrSummarized": true,
  "structurallyRelevantMemoryRefsMustBePreserved": true,
  "aiMayUseOnlyAvailableRelevantMemories": true,
  "aiCannotInventSharedHistoryOrMissingDetails": true,
  "aiMayExpressUncertaintyOrNoRecall": true,
  "memoryRecordFields": [
    "memory_id",
    "npc_ref",
    "source_event_refs",
    "subject_refs",
    "memory_state",
    "gist",
    "detail_refs_if_any",
    "interpretation",
    "emotion_refs_if_any",
    "salience_context",
    "created_time",
    "last_recalled_time_if_any",
    "last_update_time"
  ]
}

    {
      "testId": "URBAN_TRESKAL_001",
      "name": "arrival_bridge_to_market_ordinary_morning",
      "initial": {
        "approach": "APP01",
        "dynamicState": "D12",
        "daypart": "morning",
        "weather": "stable",
        "playerRouteKnowledge": "heard_of"
      },
      "actions": [
        "enter_city",
        "cross_main_bridge",
        "follow_C01",
        "reach_L03"
      ],
      "required": [
        "gradual LOD promotion",
        "no universal gate checkpoint",
        "traffic shifts from territorial to urban",
        "market density higher than residential edge",
        "player route becomes travelled"
      ],
      "forbidden": [
        "city appears fully populated at invisible load line",
        "Royal Shipyards dominate arrival from APP01"
      ]
    },
    {

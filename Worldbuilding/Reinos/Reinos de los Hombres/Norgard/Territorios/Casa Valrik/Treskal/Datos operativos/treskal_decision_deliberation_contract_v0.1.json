{
  "schemaVersion": 1,
  "documentId": "treskal_decision_deliberation_contract",
  "version": "0.1",
  "status": "active_design_contract",
  "decisionStates": {
    "DEC01": "choice_pending",
    "DEC02": "options_identified",
    "DEC03": "evaluating_tradeoffs",
    "DEC04": "choice_made",
    "DEC05": "action_started",
    "DEC06": "reconsidered",
    "DEC07": "abandoned_choice",
    "DEC08": "decision_resolved"
  },
  "decisionUsesKnownOptionsOnly": true,
  "hiddenWorldStateCannotBeUsedAsDecisionInput": true,
  "decisionIsNotUniversalUtilityOptimization": true,
  "multipleGoalsMayCompete": true,
  "obligationsMayConstrainChoice": true,
  "emotionAndMoodMayInfluenceButNotDetermineChoice": true,
  "personalityMayBiasChoiceButDoesNotGuaranteeOutcome": true,
  "relationshipMayInfluenceButDoesNotCreateUnlimitedSacrifice": true,
  "indecisionIsValid": true,
  "urgentDecisionsMayUseReducedDeliberation": true,
  "choiceDoesNotCompleteAction": true,
  "actionStillRequiresOwningSystemValidation": true,
  "realRiskAndPerceivedRiskAreSeparate": true,
  "riskAssessmentLimitedByKnowledgeExperienceAndCredibility": true,
  "npcMayUnderestimateOrOverestimateRisk": true,
  "newInformationMayTriggerReconsideration": true,
  "changeOfMindIsNotInconsistencyWhenContextChanges": true,
  "controlledVariationMayBreakNearEquivalentChoices": true,
  "randomnessCannotOverrideCriticalKnowledgeOrPhysicalPossibility": true,
  "goodDecisionMayHaveBadOutcome": true,
  "badDecisionMayHaveGoodOutcome": true,
  "significantDecisionMayBecomeMemory": true,
  "playerCanInfluenceButNotDirectlyOwnNpcChoice": true,
  "aiMayProposeChoiceFromAuthorizedContext": true,
  "aiCannotInventOptionsResourcesPermissionsOrKnowledge": true,
  "offscreenDecisionRequiresContextKnownOptionsMotiveAndTime": true,
  "decisionRecordFields": [
    "decision_id",
    "npc_ref",
    "decision_state",
    "option_refs",
    "known_fact_refs",
    "credibility_refs_if_any",
    "goal_refs",
    "obligation_refs",
    "emotion_refs_if_any",
    "relationship_refs_if_any",
    "selected_option_ref_if_any",
    "reason_refs_if_any",
    "created_time",
    "last_update_time",
    "result_ref_if_any"
  ]
}

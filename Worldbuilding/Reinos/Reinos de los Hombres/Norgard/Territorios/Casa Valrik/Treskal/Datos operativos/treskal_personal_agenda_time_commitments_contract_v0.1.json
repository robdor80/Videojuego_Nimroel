{
  "schemaVersion": 1,
  "documentId": "treskal_personal_agenda_time_commitments_contract",
  "version": "0.1",
  "status": "active_design_contract",
  "agendaStates": {
    "AGEN01": "tentative_plan",
    "AGEN02": "scheduled_activity",
    "AGEN03": "confirmed_commitment",
    "AGEN04": "in_progress",
    "AGEN05": "delayed",
    "AGEN06": "rescheduled",
    "AGEN07": "cancelled",
    "AGEN08": "missed",
    "AGEN09": "completed"
  },
  "exactClockTimesRequired": false,
  "qualitativeTimeAnchorsAllowed": true,
  "timeCannotBeDuplicated": true,
  "incompatibleActivitiesCannotRunInParallelForSameNpc": true,
  "agendaMayCoordinate": [
    "employment",
    "care",
    "rest",
    "goal",
    "pledge",
    "hospitality",
    "travel",
    "commission",
    "visit",
    "service",
    "event"
  ],
  "agendaDoesNotReplaceOwningSystems": true,
  "goalPlanDoesNotAutomaticallyReserveTime": true,
  "travelTimeMustBeCompatible": true,
  "routineDoesNotRequirePersistentEntryUnlessConsequential": true,
  "restConsumesTime": true,
  "waitingConsumesTime": true,
  "dialogueConsumesTime": true,
  "needsMayRequireTimeAllocation": true,
  "conflictResolutionMayUseDEC": true,
  "delayRequiresPlausibleCause": true,
  "rescheduleRequiresNewPlausibleWindow": true,
  "reschedulingOtherActorRequiresTheirAvailabilityOrAgreement": true,
  "missedAndCancelledAreDistinct": true,
  "pledgeConsequencesRemainOwnedByPLEDGE": true,
  "offscreenActivityRequiresAgendaCompatibility": true,
  "lodCannotExecuteIncompatibleIntentionsInParallel": true,
  "playerCannotCreateFreeTimeByStartingDialogue": true,
  "aiMayReferenceRelevantAgenda": true,
  "aiCannotCreateNonexistentAvailability": true,
  "agendaRecordFields": [
    "agenda_item_id",
    "npc_ref",
    "activity_ref",
    "agenda_state",
    "source_system_ref",
    "time_anchor",
    "location_ref_if_any",
    "participant_refs_if_any",
    "travel_dependency_refs_if_any",
    "priority_context_if_any",
    "delay_or_cancel_reason_ref_if_any",
    "created_time",
    "last_update_time"
  ],
  "externalDependencies": {
    "exactClockAndCalendarScheduling": "future_Nimroel_time_system"
  }
}

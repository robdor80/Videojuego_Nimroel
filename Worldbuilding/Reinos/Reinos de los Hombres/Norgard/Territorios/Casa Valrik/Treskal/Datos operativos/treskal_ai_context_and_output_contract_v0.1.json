{
  "schemaVersion": 1,
  "documentId": "treskal_ai_context_and_output_contract",
  "version": "0.1",
  "status": "active_design_contract",
  "narratorPipeline": [
    "world_state",
    "perception_filter",
    "authorized_context",
    "narrative_model",
    "output_validation",
    "player_text"
  ],
  "hiddenFactsExcludedFromDefaultNarratorContext": true,
  "perceptionFocusPipeline": [
    "player_focus_intent",
    "engine_resolution",
    "authorized_discoveries",
    "narrative_model"
  ],
  "narratorForbiddenLeaks": [
    "hidden_objects",
    "unknown_identity",
    "npc_private_intent",
    "inaudible_conversation",
    "unseen_room_contents",
    "undetected_traps"
  ],
  "environmentalContextUsesPersistentState": true,
  "narratorCannotMutateWorldState": true,
  "npcDialogueContext": {
    "include": [
      "identity",
      "immediate_perception",
      "K1_K5_relevant_knowledge",
      "relevant_memory",
      "applicable_reputation",
      "current_activity",
      "culture_personality",
      "persistent_personality_compact_block",
      "known_name_and_authorized_aliases"
    ],
    "exclude": [
      "full_world_state",
      "K0_as_available_fact",
      "global_npc_positions",
      "unrelated_secrets"
    ],
    "knowsDoesNotMeanDiscloses": true,
    "lyingAllowedAsUtteranceNotWorldTruth": true,
    "unknownAnswersAllowed": true,
    "personalitySource": "Worldbuilding/Sistemas/Nimroel Core/Datos operativos/nimroel_ai_personality_expression_context_contract_v0.1.json",
    "personalityAiAuthority": {
      "express": true,
      "mutateProfile": false,
      "createPermanentTraits": false,
      "promoteNpcTier": false
    },
    "namingSource": "Worldbuilding/Sistemas/Nimroel Core/Datos operativos/nimroel_personal_name_identity_contract_v0.1.json",
    "namingAiAuthority": {
      "mayUseKnownName": true,
      "mayUseKnownAlias": true,
      "mayRevealUnknownLegalName": false,
      "mayInventPersistentName": false,
      "mayInferKinshipFromSurname": false,
      "mayGrantTitleFromSurname": false
    }
  },
  "outputTypes": [
    "text",
    "intent",
    "action_proposal",
    "fact_proposal"
  ],
  "stateMutationRequiresEngineValidation": true,
  "aiContradictionNeverRewritesWorldToMatchOutput": true,
  "entityCreationFromCasualMentionForbidden": true,
  "ephemeralExpressionAllowed": [
    "tone",
    "gesture",
    "pause",
    "wording"
  ],
  "providerIndependent": true,
  "comparativeTestInputsMustMatchAcrossModels": true,
  "comparativeEvaluation": [
    "personality",
    "subtext",
    "coherence",
    "memory",
    "lying_behavior",
    "limited_knowledge",
    "naturalness",
    "secret_discipline"
  ],
  "personalityOutputValidation": [
    "profile_consistency",
    "no_invented_trait_history",
    "no_relationship_substitution_for_global_personality",
    "current_state_not_persisted_as_personality_without_engine_event"
  ]
}

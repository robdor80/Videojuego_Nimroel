{
  "schemaVersion": 1,
  "documentId": "nimroel_expectation_revision_contract",
  "version": "0.1",
  "status": "active_core_contract",
  "authorityScope": "nimroel_universal",
  "appliesTo": "persistent_actor_expectations",
  "sourcePrototype": "Treskal layer 92",
  "stableIdNamespace": {
    "EXP": "expectation_state"
  },
  "expectationStates": {
    "EXP01": "tentative_expectation",
    "EXP02": "established_expectation",
    "EXP03": "uncertain_outcome",
    "EXP04": "expectation_met",
    "EXP05": "better_than_expected",
    "EXP06": "worse_than_expected",
    "EXP07": "unexpected_outcome",
    "EXP08": "revised_expectation"
  },
  "expectationIsNotFutureKnowledge": true,
  "expectationIsActorSpecific": true,
  "expectationRequiresKnowledgeExperiencePatternOrSource": true,
  "hiddenFutureWorldStateCannotDirectlyCreateExpectation": true,
  "expectationMayDeriveFrom": [
    "habit",
    "trust",
    "pledge",
    "memory",
    "credibility",
    "profession",
    "relationship",
    "observed_pattern",
    "received_information",
    "goal"
  ],
  "uncertaintyIsValid": true,
  "expectationDoesNotGuaranteeOutcome": true,
  "sameOutcomeMayBeExpectedByOneNpcAndUnexpectedByAnother": true,
  "resultComparisonRequiresNpcToKnowOutcome": true,
  "expectationCanRemainActiveWhileOutcomeIsUnknown": true,
  "unexpectedOutcomeMayInfluence": [
    "emotion",
    "mood",
    "trust",
    "credibility",
    "goal",
    "decision",
    "memory"
  ],
  "expectationDoesNotDirectlyMutateThoseSystemsWithoutOwningEvent": true,
  "singleExceptionDoesNotAutomaticallyRewriteStableExpectation": true,
  "significantOrRepeatedEvidenceMayReviseExpectation": true,
  "failedPredictionDoesNotProveDeception": true,
  "fulfilledExpectationDoesNotProveTruthfulnessOfEverySource": true,
  "playerMayCreateExpectationsThroughPromisesHabitsAndHistory": true,
  "offscreenResolutionRequiresOutcomeAndKnowledgePath": true,
  "aiMayExpressUncertaintyAndConditionalPrediction": true,
  "aiCannotUseHiddenFutureInformationForPrediction": true,
  "aiCannotExpressSurpriseWithoutPriorExpectationMismatch": true,
  "expectationRecordFields": [
    "expectation_id",
    "npc_ref",
    "subject_ref_or_description",
    "expected_outcome_ref_or_description",
    "expectation_state",
    "basis_refs",
    "confidence_context_if_any",
    "created_time",
    "resolved_time_if_any",
    "observed_result_ref_if_any",
    "revision_refs_if_any"
  ]
}

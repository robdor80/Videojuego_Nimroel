    "NAME03": "former_legal_name",
    "NAME04": "alias_or_byname",
    "NAME05": "unknown_or_unresolved"
  },
  "technicalIdentitySeparateFromVisibleName": true,
  "nameRecordFields": [
    "name_record_id",
    "npc_id",
    "given_name",
    "additional_given_names",
    "family_name",
    "display_name",
    "NAME_state",
    "culture_scope",
    "source_event_ref",
    "valid_from",
    "valid_to_if_former",

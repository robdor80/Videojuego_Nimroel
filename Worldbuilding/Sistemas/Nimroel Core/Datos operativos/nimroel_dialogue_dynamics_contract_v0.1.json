{
  "schemaVersion": 1,
  "documentId": "nimroel_dialogue_dynamics_contract",
  "version": "0.1",
  "status": "active_core_contract",
  "authorityScope": "nimroel_universal",
  "appliesTo": "persistent_actor_dialogue_dynamics",
  "sourcePrototype": "Treskal layer 95",
  "stableIdNamespace": {
    "DIAL": "dialogue_state"
  },
  "dialogueStates": {
    "DIAL01": "available_for_conversation",
    "DIAL02": "engaged",
    "DIAL03": "guarded",
    "DIAL04": "topic_refused",
    "DIAL05": "hurried_or_limited",
    "DIAL06": "interrupted",
    "DIAL07": "closing",
    "DIAL08": "ended"
  },
  "conversationRequiresPresenceAndPlausibleAudibility": true,
  "playerDoesNotFreezeNpcLife": true,
  "npcMayRefuseConversation": true,
  "npcMayRefuseSpecificTopicWithoutEndingAllDialogue": true,
  "npcMayInitiateQuestionRequestTopicChangeOrClosure": true,
  "conversationMayCoexistWithCompatibleActivity": true,
  "attentionStateMayLimitConversation": true,
  "dialogueDoesNotGrantKnowledge": true,
  "knowingDoesNotRequireDisclosure": true,
  "dialogueMayUse": [
    "K",
    "MEM",
    "CRED",
    "CONF",
    "TRUST",
    "PERS",
    "VAL",
    "GOAL",
    "EMO",
    "MOOD",
    "STRS",
    "ATTN",
    "REQ"
  ],
  "dialogueMayGenerateWhenValidated": [
    "STAT",
    "REQ",
    "PLEDGE",
    "CONF",
    "FAV",
    "RIFT",
    "knowledge_delta",
    "MEM"
  ],
  "repeatedQuestionDoesNotUnlockInformationByItself": true,
  "conversationCanBeInterruptedByRealEvent": true,
  "conversationCanResumeIfContextStillSupportsIt": true,
  "npcCanEndConversationWithoutPlayerPermission": true,
  "clearClosureCanBeIgnoredOnlyAsNewSocialAction": true,
  "insistenceAfterClosureMayAffectRelationships": true,
  "notEveryLineRequiresPersistentStorage": true,
  "importantTopicsMayPersistThroughMemory": true,
  "offscreenConversationRequiresPlausibleMeetingTimeAndMotive": true,
  "aiMayProposeConversationClosure": true,
  "aiCannotExecuteMaterialActionsDirectly": true,
  "aiCannotKeepConversationOpenAgainstWorldState": true,
  "dialogueRecordFields": [
    "conversation_id",
    "participant_refs",
    "dialogue_state",
    "location_ref",
    "privacy_context_ref",
    "attention_refs_if_relevant",
    "active_topic_refs_if_any",
    "pending_question_refs_if_any",
    "start_time",
    "end_time_if_any",
    "interruption_ref_if_any",
    "persistent_consequence_refs_if_any"
  ]
}

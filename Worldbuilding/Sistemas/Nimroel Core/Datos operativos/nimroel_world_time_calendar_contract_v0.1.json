      {
        "index": 4,
        "name": "jueves"
      },
      {
        "index": 5,
        "name": "viernes"
      },
      {
        "index": 6,
        "name": "sábado"
      },
      {
        "index": 7,
        "name": "domingo"
      }
    ],
    "weekStartsOn": "lunes",
    "epochAnchor": {
      "date": "0001-01-01",
      "weekday": "lunes"
    },
    "earthEtymologyImplied": false
  },
  "clock": {
    "format24Hour": true,
    "daylightSaving": false,
    "timeZones": false,
    "civilDayStarts": "00:00:00",
    "civilDayEnds": "23:59:59",
    "internalDateFormat": "YYYY-MM-DD",
    "internalDateTimeFormat": "YYYY-MM-DDTHH:mm:ss",
    "visibleSpanishDateFormat": "D de <mes> de YYYY",
    "numericDateFormat": "DD/MM/YYYY"
  },
  "dayparts": [
    {
      "id": "madrugada",
      "start": "00:00",
      "end": "05:59"
    },
    {
      "id": "mañana",
      "start": "06:00",
      "end": "11:59"
    },
    {
      "id": "mediodía",
      "start": "12:00",
      "end": "13:59"
    },
    {
      "id": "tarde",
      "start": "14:00",
      "end": "19:59"
    },
    {
      "id": "noche",
      "start": "20:00",
      "end": "23:59"
    }
  ],
  "solarRules": {
    "sunriseAndSunsetFixedByClock": false,
    "futureLocationAndSeasonModelMayResolve": true,
    "daypartDoesNotOverrideAmbientLight": true
  },
  "arithmetic": {
    "distinguishElapsedDurationFromCivilDateArithmetic": true,
    "addMonthRule": "same_day_if_valid_else_last_day_of_target_month",
    "addYearRule": "same_month_and_day_next_year",
    "weekdayDerivedFromEpoch": true
  },
  "ageCalculation": {
    "basedOnBirthDate": true,
    "birthdayAtStartOfMatchingCivilDate": true,
    "celebrationNotRequiredForAgeChange": true
  },
  "persistence": {
    "monotonicAbsoluteTimeRequired": true,
    "saveLoadPreservesExactTime": true,
    "lodChangeDoesNotResetTime": true,
    "offscreenTimeAdvances": true,
    "timeSkipMustProcessRelevantConsequences": true
  },
  "scheduling": {
    "exactDateTimeSupported": true,
    "dateOnlySupported": true,
    "daypartSupported": true,
    "relativeWindowSupported": true,
    "owningSystemMustDeclareDeadlineSemantics": true
  },
  "aiAuthority": {
    "mayReferenceProvidedDateTime": true,
    "mayResolveNaturalLanguageRelativeTimeFromContext": true,
    "mayAdvanceTime": false,
    "mayChangeDeadline": false,
    "mayInventElapsedTime": false
  },
  "guardrails": {
    "noLeapYears": true,
    "noEarthReligiousMeaningFromWeekdayOrMonthNames": true,
    "noAutomaticWeekendClosure": true,
    "noAutomaticSundayRest": true,
    "noPerRegionTimeZones": true
  }
